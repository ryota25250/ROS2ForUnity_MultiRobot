  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"rear_lrf_link\">\n  <sensor name=\"rear_lrf_sensor\"
    type=\"ray\">\n    <pose>0 0 0 0 0 0</pose>\n    <visualize>true</visualize>\n   
    <update_rate>40</update_rate>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>720</samples>\n          <resolution>1</resolution>\n          <min_angle>-2.35619449019</min_angle>\n         
    <max_angle>2.35619449019</max_angle>\n        </horizontal>\n      </scan>\n     
    <range>\n        <min>0.1</min>\n        <max>60.0</max>\n        <resolution>0.01</resolution>\n     
    </range>\n      <noise>\n        <type>gaussian</type>\n        <mean>0.0</mean>\n       
    <stddev>0.03</stddev>\n      </noise>\n    </ray>\n    <plugin filename=\"libgazebo_ros_laser.so\"
    name=\"gazebo_ros_rear_lrf_controller\">\n      <topicName>rear/scan</topicName>\n     
    <frameName>rear_lrf_link</frameName>\n    </plugin>\n  </sensor>\n</gazebo>"
